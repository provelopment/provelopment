{
  "site": {
    "url": "https://foundation-template.provelopment.com",
    "name": "Provelopment Foundation",
    "tagline": "An open-source website template you can own",
    "description": "This website is a working deployment of the Provelopment Foundation template: the same public code, downloadable and deployable by anyone. It is the template's own reference site, not a client website.",
    "assets": {
      "favicon": "https://foundation-template.provelopment.com/assets/favicon.svg"
    }
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": [
      {
        "code": "en",
        "label": "English",
        "englishLabel": "English"
      }
    ]
  },
  "sites": [
    {
      "code": "ww"
    }
  ],
  "contact": {
    "email": "hello@example.com"
  },
  "socialLinks": [],
  "navigation": [
    {
      "label": "Home",
      "href": "/",
      "iconOpen": "icon-home.svg",
      "iconClosed": "icon-home.svg"
    },
    {
      "label": "About",
      "href": "/about",
      "iconOpen": "icon-about.svg",
      "iconClosed": "icon-about.svg"
    }
  ],
  "features": {
    "analytics": {
      "provider": "none"
    },
    "maps": {
      "provider": "none"
    },
    "booking": {
      "provider": "none"
    },
    "contact": {
      "provider": "stub"
    }
  },
  "ui": {
    "density": "comfortable",
    "content": {
      "width": "standard"
    },
    "theme": {
      "mode": "system",
      "radius": "medium"
    },
    "layoutSwitcher": {
      "enabled": true,
      "default": "sidebar"
    }
  }
}