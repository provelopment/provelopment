{
  "name": "provelopment-foundation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-runtime-assets.mjs && next dev",
    "build": "node scripts/sync-runtime-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:foundation": "vitest run --project foundation",
    "test:deployment": "vitest run --project deployment",
    "test:browser": "node tests/browser/matrix.mjs",
    "test:browser:foundation": "node tests/browser/matrix.mjs --scope foundation",
    "test:browser:deployment": "node tests/browser/matrix.mjs --scope deployment",
    "assets:sync": "node scripts/sync-runtime-assets.mjs",
    "assets:check": "node scripts/sync-runtime-assets.mjs --check",
    "country-codes:sync": "node scripts/generate-country-code-reference.mjs",
    "country-codes:check": "node scripts/generate-country-code-reference.mjs --check",
    "postinstall": "node scripts/sync-runtime-assets.mjs --if-deployment",
    "release:classify": "node scripts/release/index.mjs classify",
    "release:build": "node scripts/release/index.mjs build",
    "release:verify": "node scripts/release/index.mjs verify"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "marked": "^18.0.11",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  }
}
