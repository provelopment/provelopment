# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated runtime asset namespaces (FOUNDATION-DEPLOYMENT-ISO-B3C1 / S3E1C)
#
# The deployment's `content/assets/**` is the ONE authority; the runtime namespaces are derived from it by
# `scripts/sync-runtime-assets.mjs`:
#
#   /public/assets/          the SHARED platform namespace (icon library, platform marks, and — in legacy
#                            mode — the replaceable role artwork)
#   /public/spokes/          one NAMESPACE PER DECLARED SPOKE (`/spokes/<runtime-segment>/assets`), so two
#                            Spokes may ship the same asset basename without either overwriting the other
#
# Both are regenerated by `pnpm install` (postinstall), `pnpm dev` and `pnpm build`, so a fresh clone never
# needs a committed copy — and nothing derived can disagree with its source in version control. Both rules
# are root-anchored: the deployment's own source tree (the capsule's
# `deployment/spokes/<spoke>/content/assets/**`) is NOT ignored by them.
/public/assets/
/public/spokes/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
