# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated runtime asset mirror (FOUNDATION-DEPLOYMENT-ISO-B3C1)
#
# The deployment's `content/assets/**` is the ONE authority; `public/assets/**` is derived from it by
# `scripts/sync-runtime-assets.mjs`. It is regenerated by `pnpm install` (postinstall), `pnpm dev` and
# `pnpm build`, so a fresh clone never needs a committed copy — and nothing derived can disagree with
# its source in version control. `/public/assets/` is root-anchored: the deployment's own source tree
# (the capsule's `deployment/content/assets/**`) is NOT ignored by this rule.
/public/assets/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
